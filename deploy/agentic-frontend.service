[Unit]
Description=Agentic Audit AI Frontend Dashboard (Vite)
After=network.target

[Service]
User=kali
Group=kali
WorkingDirectory=/home/kali/agentic-audit-ai/frontend
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 4173
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
