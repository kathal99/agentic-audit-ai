[Unit]
Description=Agentic Audit AI Backend Engine (FastAPI)
After=network.target

[Service]
User=kali
Group=kali
WorkingDirectory=/home/kali/agentic-audit-ai/backend
Environment="PATH=/home/kali/agentic-audit-ai/venv/bin"
ExecStart=/home/kali/agentic-audit-ai/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
